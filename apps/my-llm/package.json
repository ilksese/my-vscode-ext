{
  "name": "my-llm",
  "displayName": "My LLM",
  "description": "Custom OpenAI-compatible language model provider for VS Code Chat",
  "version": "0.0.1",
  "private": true,
  "publisher": "ilksese",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilksese/my-vscode-ext"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguageModelChat:my-llm"
  ],
  "contributes": {
    "configuration": {
      "title": "My LLM",
      "properties": {
        "my-llm.providers": {
          "type": "array",
          "default": [],
          "markdownDescription": "OpenAI 兼容的模型供应商列表。每个条目需配置 `baseUrl`、`apiKey` 与 `models`。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "baseUrl",
              "apiKey",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "供应商唯一标识，用于区分不同供应商"
              },
              "name": {
                "type": "string",
                "description": "供应商显示名称，缺省使用 id"
              },
              "baseUrl": {
                "type": "string",
                "description": "OpenAI 兼容 API 的基础地址，例如 https://api.openai.com/v1"
              },
              "apiKey": {
                "type": "string",
                "description": "API 密钥"
              },
              "apiProtocol": {
                "type": "string",
                "enum": [
                  "openai",
                  "openai-compatible"
                ],
                "description": "API 协议，缺省为 openai。model 层可覆盖此值"
              },
              "models": {
                "type": "array",
                "description": "可用模型列表",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "模型标识，如 gpt-4o-mini"
                    },
                    "name": {
                      "type": "string",
                      "description": "显示名称，缺省使用 id"
                    },
                    "family": {
                      "type": "string",
                      "description": "模型家族名，缺省使用 id"
                    },
                    "version": {
                      "type": "string",
                      "description": "模型版本，缺省为 '1.0.0'"
                    },
                    "apiProtocol": {
                      "type": "string",
                      "enum": [
                        "openai",
                        "openai-compatible"
                      ],
                      "description": "API 协议，覆盖 provider 层设置，缺省继承 provider"
                    },
                    "maxInputTokens": {
                      "type": "integer",
                      "description": "上下文大小：最大输入 token 数，缺省 128000"
                    },
                    "maxOutputTokens": {
                      "type": "integer",
                      "description": "最大输出 token 数，缺省 4096"
                    },
                    "toolCalling": {
                      "type": "boolean",
                      "description": "是否声明支持工具调用，缺省 false"
                    },
                    "imageInput": {
                      "type": "boolean",
                      "description": "是否声明支持图片输入，缺省 false"
                    },
                    "pricing": {
                      "type": "object",
                      "description": "每百万 token 价格（美元），显示在模型提示与 Language Models 面板价格列",
                      "properties": {
                        "input": {
                          "type": "number",
                          "description": "输入价格，$/1M tokens"
                        },
                        "output": {
                          "type": "number",
                          "description": "输出价格，$/1M tokens"
                        }
                      }
                    },
                    "defaultReasoningEffort": {
                      "type": "string",
                      "enum": [
                        "none",
                        "minimal",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ],
                      "description": "默认思考强度，作为模型配置中 reasoningEffort 的默认值；请求时可被模型配置覆盖，缺省不发送该参数"
                    },
                    "reasoningEfforts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "none",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max"
                        ]
                      },
                      "description": "该模型有效的思考强度档位，展示为模型配置中 reasoningEffort 的可选项；缺省为全量 7 档"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "my-llm",
        "displayName": "My LLM"
      }
    ],
    "commands": [
      {
        "command": "my-llm.patchModel",
        "title": "my-llm: patch model"
      }
    ]
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts",
    "dev": "tsc --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --packagePath $(ls -t *.vsix | head -1)"
  },
  "devDependencies": {
    "@suite/tsconfig": "workspace:*",
    "@types/node": "20.0.0",
    "@types/vscode": "1.134.0",
    "@vscode/vsce": "3.9.2",
    "tsdown": "0.21.10",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.123",
    "@ai-sdk/openai-compatible": "1.0.53",
    "ai": "5.0.250"
  }
}
